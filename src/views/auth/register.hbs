{{setTitle 'Create Account | WorkHub'}}

<main class="register-page">
    <section class="register-card">
        <div class="register-header">
            <p class="section-label">Create account</p>
            <h1>Join WorkHub</h1>
            <p>Create your account and start organizing your projects.</p>
        </div>

        {{#if error}}
        <div class="alert alert-error" role="alert">
            {{error}}
        </div>
        {{/if}}

        <form method="POST" class="register-form">
            <div class="form-row">
                <div class="form-group">
                    <label for="firstName">First name</label>

                    <input type="text" id="firstName" name="firstName" value="{{formData.firstName}}" placeholder="Jane"
                        autocomplete="given-name">

                    {{#if errors.firstName}}
                    <p class="field-error">{{errors.firstName}}</p>
                    {{/if}}
                </div>

                <div class="form-group">
                    <label for="lastName">Last name</label>

                    <input type="text" id="lastName" name="lastName" value="{{formData.lastName}}" placeholder="Smith"
                        autocomplete="family-name">

                    {{#if errors.lastName}}
                    <p class="field-error">{{errors.lastName}}</p>
                    {{/if}}
                </div>
            </div>

            <div class="form-group">
                <label for="email">Email address</label>

                <input type="text" id="email" name="email" value="{{formData.email}}" placeholder="jane@example.com"
                    autocomplete="email">

                {{#if errors.email}}
                <p class="field-error">{{errors.email}}</p>
                {{/if}}
            </div>

            <div class="form-group">
                <label for="password">Password</label>

                <input type="password" id="password" name="password" placeholder="Enter your password"
                    autocomplete="new-password">

                {{#if errors.password}}
                <p class="field-error">{{errors.password}}</p>
                {{else}}
                <p class="field-hint">
                    At least 6 characters, including a letter and a number.
                </p>
                {{/if}}
            </div>

            <div class="form-group">
                <label for="rePassword">Confirm password</label>

                <input type="password" id="rePassword" name="rePassword" placeholder="Repeat your password"
                    autocomplete="new-password">

                {{#if errors.rePassword}}
                <p class="field-error">{{errors.rePassword}}</p>
                {{/if}}
            </div>

            <button type="submit" class="button button-primary register-submit">
                Create Account
            </button>
        </form>

        <p class="register-footer">
            Already have an account?
            <a href="/auth/login">Log in</a>
        </p>
    </section>
</main>