{{setTitle 'Login | WorkHub'}}

<main class="login-page">
    <section class="login-card">
        <div class="login-header">
            <p class="section-label">Welcome back</p>

            <h1>Log in to WorkHub</h1>

            <p>
                Enter your account details to continue.
            </p>
        </div>

        {{#if error}}
        <div class="alert alert-error" role="alert">
            {{error}}
        </div>
        {{/if}}

        <form method="POST" class="login-form">
            <div class="form-group">
                <label for="email">Email address</label>

                <input type="text" id="email" name="email" value="{{formData.email}}" placeholder="jane@example.com"
                    autocomplete="email">

                {{#if errors.email}}
                <p class="field-error">{{errors.email}}</p>
                {{/if}}
            </div>

            <div class="form-group">
                <div class="password-label-row">
                    <label for="password">Password</label>

                    <a href="/auth/forgot-password" class="forgot-password-link">
                        Forgot password?
                    </a>
                </div>

                <input type="password" id="password" name="password" placeholder="Enter your password"
                    autocomplete="current-password">

                {{#if errors.password}}
                <p class="field-error">{{errors.password}}</p>
                {{/if}}
            </div>

            <label class="remember-field" for="rememberMe">
                <input type="checkbox" id="rememberMe" name="rememberMe" value="true">

                <span>Remember me</span>
            </label>

            <button type="submit" class="button button-primary login-submit">
                Log In
            </button>
        </form>

        <p class="login-footer">
            Don't have an account?
            <a href="/auth/register">Create one</a>
        </p>
    </section>
</main>