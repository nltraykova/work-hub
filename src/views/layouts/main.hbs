<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{#if pageTitle}}{{pageTitle}}{{else}}WorkHub | Organize projects. Collaborate better.{{/if}}</title>

    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <header class="site-header">
        <div class="container header-container">
            <a href="/" class="logo">
                Work<span>Hub</span>
            </a>

            <nav class="main-navigation" aria-label="Main navigation">
                <ul class="navigation-list">
                    <li>
                        <a href="#features">Features</a>
                    </li>

                    <li>
                        <a href="#how-it-works">How It Works</a>
                    </li>

                    <li>
                        <a href="#about">About</a>
                    </li>
                </ul>
            </nav>

            <div class="header-actions">
                {{#if user}}
                <a href="/auth/logout" class="button button-secondary">Log Out</a>
                {{else}}
                <a href="/auth/register" class="button button-primary">Get Started</a>
                <a href="/auth/login" class="button button-secondary">Log In</a>
                {{/if}}
            </div>
        </div>
    </header>
    {{{body}}}
    <footer class="site-footer">
        <div class="container footer-container">
            <div class="footer-brand">
                <a href="/" class="logo">
                    Work<span>Hub</span>
                </a>

                <p>
                    A simple workspace for projects, tasks, and team collaboration.
                </p>
            </div>

            <div class="footer-navigation">
                <div>
                    <h3>Product</h3>

                    <ul>
                        <li>
                            <a href="#features">Features</a>
                        </li>

                        <li>
                            <a href="#how-it-works">How It Works</a>
                        </li>

                        <li>
                            <a href="/auth/register">Create Account</a>
                        </li>
                    </ul>
                </div>

                <div>
                    <h3>Account</h3>

                    <ul>
                        <li>
                            <a href="/auth/login">Log In</a>
                        </li>

                        <li>
                            <a href="/auth/register">Register</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container">
                <p>&copy; 2026 WorkHub. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>

</html>